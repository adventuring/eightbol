@node SCUMM Grammar Overview
@section Grammar Overview

@subsection Script Structure

A SCUMM script consists of:

@enumerate
@item Variable declarations
@item Object definitions
@item Function definitions
@item Script/routine implementations
@end enumerate

@example
variable global_counter = 0;

object Treasure
  name "Golden Statue";
  pos 100 100;
  class Movable;
  method take() { ... }
end;

function greet(actor_id) {
  return "Hello " + get_actor_name(actor_id);
}

script main {
  // main execution
}
@end example

@subsection Execution Model

Scripts execute in the context of:

@itemize
@item Global variable state
@item Active actors and objects
@item Current room/location
@item Event queue for deferred actions
@end itemize

@node SCUMM Statements
@section Statements

@subsection Variable Declaration

@strong{Syntax}:
@example
variable name [= initial_value];
local name = value;
@end example

@strong{Semantics}: Declares variable with optional initialization. @code{variable} for globals, @code{local} for function scope.

@strong{Examples}:

@example
variable score = 0;
variable inventory_size = 0;
local temp_x = 100;
@end example

@strong{AST}: @code{(:move :target name :source init-value)}

@subsection Assignment

@strong{Syntax}:
@example
variable = expression;
object.property = value;
array[index] = value;
@end example

@strong{Semantics}: Assigns value to variable, property, or array element.

@strong{Examples}:

@example
score = score + 100;
actor.health = 50;
inventory[0] = sword;
@end example

@strong{AST}: @code{(:move :target variable :source expression)}

@subsection Arithmetic Operations

@strong{Syntax}:
@example
variable = operand1 + operand2;
variable = operand1 - operand2;
variable = operand1 * operand2;
variable = operand1 / operand2;
@end example

@strong{Examples}:

@example
total = price + tax;
damage = attack * weakness_multiplier;
health = max_health / 2;
@end example

@strong{AST}: @code{(:compute :op :+ :operands (operand1 operand2))}

@subsection Conditional Statement

@strong{Syntax}:
@example
if condition then
  statements;
else if condition2 then
  statements;
else
  statements;
end;
@end example

@strong{Semantics}: Conditional execution with multiple branches.

@strong{Examples}:

@example
if health <= 0 then
  game_over = 1;
else if health < 25 then
  play_warning_sound();
else
  continue_game();
end;
@end example

@strong{AST}: @code{(:if :condition cond :then then-block :else else-block)}

@subsection Loop Statements

@strong{For Loop}:
@example
for i = 0 to 10 do
  process_item(i);
end;
@end example

@strong{While Loop}:
@example
while condition do
  process();
end;
@end example

@strong{Repeat-Until Loop}:
@example
repeat
  process()
until condition;
@end example

@strong{Examples}:

@example
for i = 0 to actor_count do
  if actors[i].alive then
    update_actor(actors[i]);
  end;
end;

while inventory.count > 0 do
  item = inventory.pop();
  use_item(item);
end;
@end example

@strong{AST}: @code{(:perform :target loop-label)}

@subsection Function Definition

@strong{Syntax}:
@example
function name(param1, param2, ...) {
  local vars;
  statements;
  return value;
}
@end example

@strong{Semantics}: Defines function with parameters and local variables.

@strong{Examples}:

@example
function distance(x1, y1, x2, y2) {
  local dx = x2 - x1;
  local dy = y2 - y1;
  return sqrt(dx * dx + dy * dy);
}

function check_collision(actor1, actor2) {
  if distance(actor1.x, actor1.y, actor2.x, actor2.y) < 10 then
    return 1;
  else
    return 0;
  end;
}
@end example

@strong{AST}: @code{(:invoke :method "name" :using params)}

@subsection Method Definition

@strong{Syntax}:
@example
method name(param1, param2, ...) {
  statements;
  return value;
}
@end example

@strong{Semantics}: Defines method on object instance.

@strong{Examples}:

@example
object Actor {
  x = 0; y = 0;
  health = 100;
  
  method take_damage(amount) {
    health = health - amount;
    if health <= 0 then
      call_death_sequence();
    end;
  }
  
  method move_to(new_x, new_y) {
    x = new_x;
    y = new_y;
  }
}
@end example

@subsection Return Statement

@strong{Syntax}:
@example
return [value];
@end example

@strong{Semantics}: Exits function/method, optionally returning value.

@strong{Examples}:

@example
function get_score() {
  return global_score;
}

function validate_move(x, y) {
  if x < 0 then return 0; end;
  if y < 0 then return 0; end;
  return 1;
}
@end example

@strong{AST}: @code{(:invoke :method "return" :using value)}

