@node SCUMM Type System
@section Type System

@subsection Primitive Types

@table @code
@item int
Integer (16 or 32 bits)
@item string
Text string
@item float
Floating-point (if supported)
@item boolean
True/false
@item void
No return value
@end table

@subsection Composite Types

@table @code
@item array
Collection of values
@item object
Named collection of properties
@item actor
Special object for animated characters
@item room
Special object for location data
@end table

@subsection Type System Semantics

@itemize
@item Implicit type coercion in most contexts
@item Strings and integers may be converted automatically
@item Arrays support indexed and named access
@item Objects support method dispatch
@end itemize

@node SCUMM Examples
@section Examples

@subsection Complete Program Example

@example
variable score = 0;
variable inventory_count = 0;
variable current_room = 1;

object Sword {
  name "Sword";
  damage = 10;
  method use(target) {
    inflict_damage(target, damage);
    score = score + 5;
  }
}

function inflict_damage(target, amount) {
  target.health = target.health - amount;
  if target.health <= 0 then
    call_death_sequence(target);
  end;
}

function main_game_loop() {
  local running = 1;
  while running do
    process_input();
    update_actors();
    check_collisions();
    render_scene();
  end;
}

script main {
  load_room(current_room);
  main_game_loop();
  shutdown();
}
@end example

@subsection Canonical Use Cases

@strong{Actor Movement}:
@example
function move_actor(actor_id, x, y) {
  local actor = get_actor(actor_id);
  actor.x = x;
  actor.y = y;
  play_walk_animation(actor_id);
}
@end example

@strong{Inventory Management}:
@example
function add_to_inventory(item) {
  if inventory_count < MAX_INVENTORY then
    inventory[inventory_count] = item;
    inventory_count = inventory_count + 1;
    display_message("Item acquired: " + item.name);
  else
    display_message("Inventory full!");
  end;
}
@end example

@subsection Best Practices

@itemize
@item Use descriptive names for all entities
@item Keep functions small and focused
@item Use local variables in functions to avoid global state pollution
@item Document complex logic with comments
@item Use objects to group related properties and methods
@item Validate inputs to public functions
@item Use constants for magic numbers (room IDs, item types, etc.)
@end itemize
