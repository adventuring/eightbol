@node Pascal Examples
@section Examples

@subsection Complete Program Example

@example
program GameEngine;
type
  Actor = record
    x, y: integer;
    health: integer;
    score: integer;
  end;

var
  player: Actor;
  enemy: Actor;
  running: boolean;

procedure InitActor(var a: Actor; x0, y0: integer);
begin
  a.x := x0;
  a.y := y0;
  a.health := 100;
  a.score := 0;
end;

procedure MoveActor(var a: Actor; dx, dy: integer);
begin
  a.x := a.x + dx;
  a.y := a.y + dy;
end;

function Distance(a1, a2: Actor): real;
var dx, dy: integer;
begin
  dx := a1.x - a2.x;
  dy := a1.y - a2.y;
  Distance := sqrt(dx * dx + dy * dy);
end;

procedure UpdateGame;
begin
  MovePlayer(player);
  MoveEnemy(enemy);
  if Distance(player, enemy) < 10 then
  begin
    writeln('Collision detected!');
    running := false;
  end;
end;

begin
  running := true;
  InitActor(player, 50, 50);
  InitActor(enemy, 200, 200);
  
  while running do
    UpdateGame;
  
  writeln('Final Score: ', player.score);
end.
@end example

@subsection Best Practices

