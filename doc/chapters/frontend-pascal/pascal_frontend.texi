@node Pascal Grammar Overview
@section Grammar Overview

@subsection Program Structure

@example
program Greeter;
  var
    name: string;
  procedure SayHello(greetee: string);
  begin
    writeln('Hello, ', greetee);
  end;
begin
  name := 'World';
  SayHello(name);
end.
@end example

@subsection Declaration Order

Pascal requires specific declaration order:

@enumerate
@item @code{program} statement
@item @code{uses} clause (optional)
@item @code{label}, @code{const}, @code{type}, @code{var} declarations
@item Procedures and functions
@item Main @code{begin...end} block
@end enumerate

@subsection Scoping

Variables and procedures have block scope. Declarations at program level are global.

@node Pascal Statements
@section Statements

@subsection Variable Declaration

@strong{Syntax}:
@example
var
  name: type;
  name1, name2: type;
@end example

@strong{Semantics}: Declares variables with specified type, optional initialization.

@strong{Examples}:

@example
var
  health: integer;
  score: integer := 0;
  message: string;
@end example

@strong{AST}: @code{(:move :target name :source init-value)}

@subsection Assignment

@strong{Syntax}:
@example
variable := expression;
@end example

@strong{Semantics}: Assigns expression value to variable.

@strong{Examples}:

@example
x := 100;
health := health - 10;
message := 'Game Over';
@end example

@strong{AST}: @code{(:move :target variable :source expression)}

@subsection Arithmetic Computation

@strong{Syntax}:
@example
variable := expr1 + expr2;
variable := expr1 * expr2;
@end example

@strong{Semantics}: Evaluates arithmetic expression, stores in variable.

@strong{Examples}:

@example
total := price + tax;
area := width * height;
result := (a + b) / 2;
@end example

@strong{AST}: @code{(:compute :op :+ :operands (expr1 expr2))}

@subsection Conditional

@strong{Syntax}:
@example
if condition then
  statements
else
  statements;
@end example

@strong{Semantics}: Conditional execution based on boolean condition.

@strong{Examples}:

@example
if score > 1000 then
  writeln('Excellent!')
else
  writeln('Try again');

if health <= 0 then
begin
  GameOver := true;
  writeln('Game Over');
end;
@end example

@strong{AST}: @code{(:if :condition cond :then then-block :else else-block)}

@subsection Case Statement

@strong{Syntax}:
@example
case selector of
  value1: statements;
  value2: statements;
  else statements
end;
@end example

@strong{Semantics}: Multi-branch dispatch based on selector value.

@strong{Examples}:

@example
case player_class of
  1: skill_points := 10;
  2: skill_points := 15;
  3: skill_points := 5;
  else skill_points := 0
end;
@end example

@strong{AST}: @code{(:evaluate :selector selector :cases (...))}

@subsection Loops

@strong{For Loop}:
@example
for i := 1 to 10 do
  writeln(i);

for i := 10 downto 1 do
  writeln(i);
@end example

@strong{While Loop}:
@example
while condition do
  statements;
@end example

@strong{Repeat-Until Loop}:
@example
repeat
  statements
until condition;
@end example

@strong{Examples}:

@example
for i := 1 to 100 do
  total := total + i;

while running do
begin
  process_input();
  render();
end;

repeat
  input := readln();
until input <> '';
@end example

@strong{AST}: @code{(:perform :target loop-label)}

@subsection Procedure Call

@strong{Syntax}:
@example
procedure_name(arg1, arg2, ...);
@end example

@strong{Semantics}: Invokes named procedure with arguments.

@strong{Examples}:

@example
ProcessInput();
MovePlayer(5, 10);
DrawScreen();
@end example

@strong{AST}: @code{(:invoke :method "name" :using args)}

@subsection Procedure Definition

@strong{Syntax}:
@example
procedure name(param1: type; param2: type);
var
  local_vars: type;
begin
  statements
end;
@end example

@strong{Semantics}: Defines procedure with parameters and local variables.

@strong{Examples}:

@example
procedure AddScore(points: integer);
begin
  Score := Score + points;
  if Score > HighScore then
    HighScore := Score;
end;

function Factorial(n: integer): integer;
begin
  if n <= 1 then
    Factorial := 1
  else
    Factorial := n * Factorial(n - 1);
end;
@end example

@subsection Function Definition

@strong{Syntax}:
@example
function name(params): return_type;
begin
  statements;
  name := result;
end;
@end example

@strong{Semantics}: Defines function returning value.

@strong{Examples}:

@example
function IsAlive: boolean;
begin
  IsAlive := Health > 0;
end;

function Distance(x1, y1, x2, y2: real): real;
begin
  Distance := sqrt(sqr(x2-x1) + sqr(y2-y1));
end;
@end example

