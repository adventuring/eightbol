@node SCI Examples
@section Examples

@subsection Complete Program Example

@example
(define NORTH 0)
(define SOUTH 1)
(define EAST 2)
(define WEST 3)

(class Actor &rest properties
  (property x 0)
  (property y 0)
  (property direction 0)
  
  (method initialize x0 y0
    (= x x0)
    (= y y0))
  
  (method move_by dx dy
    (= x (+ x dx))
    (= y (+ y dy)))
  
  (method is_alive
    (> health 0)))

(class Player species Actor
  (property health 100)
  (property score 0)
  
  (method take_damage amount
    (= health (- health amount))
    (if (<= health 0)
      (send self die)))
  
  (method add_score points
    (= score (+ score points))))

(class Game
  (method main
    (local player)
    (= player (new Player 50 50))
    (send player move_by 10 5)
    (send player take_damage 20)
    (if (send player is_alive)
      (print "Still alive!"))))
@end example

@subsection Best Practices

@itemize
@item Use classes to organize related data and methods
@item Keep methods focused and single-purpose
@item Use meaningful names for classes, methods, properties
@item Document complex algorithms with comments
@item Use constants for magic numbers
@end itemize
