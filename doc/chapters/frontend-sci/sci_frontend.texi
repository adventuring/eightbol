@node SCI Statements
@section Statements

@subsection Variable Declaration

@strong{Syntax}:
@example
local name = value;
param name = value;
@end example

@strong{Semantics}: Declares local or parameter variable.

@strong{Examples}:

@example
local x = 10;
local health = 100;
param target_x = 0;
@end example

@strong{AST}: @code{(:move :target name :source value)}

@subsection Assignment

@strong{Syntax}:
@example
variable = expression;
object.property = value;
array[index] = value;
@end example

@strong{Semantics}: Assigns value to variable, property, or array element.

@strong{Examples}:

@example
x = 100;
player.health = player.health - 10;
inventory[0] = sword;
@end example

@strong{AST}: @code{(:move :target variable :source expression)}

@subsection Arithmetic Operations

@strong{Syntax}:
@example
variable = expr1 + expr2;
variable = expr1 - expr2;
variable = expr1 * expr2;
variable = expr1 / expr2;
@end example

@strong{Examples}:

@example
damage = attack * multiplier;
new_health = health - damage;
@end example

@strong{AST}: @code{(:compute :op :+ :operands (expr1 expr2))}

@subsection Conditional Statement

@strong{Syntax}:
@example
if condition then
  statements
else
  statements
endif;

ifnot condition
  statements
else
  statements
endif;
@end example

@strong{Examples}:

@example
if health <= 0 then
begin
  print("Game Over");
  running = false;
end;

ifnot alive
  respawn_player();
endif;
@end example

@strong{AST}: @code{(:if :condition cond :then then-block :else else-block)}

@subsection Case Statement

@strong{Syntax}:
@example
switch selector
case value1
  statements;
case value2
  statements;
endswitch;
@end example

@strong{Examples}:

@example
switch player_class
case WARRIOR
  add_strength(10);
case MAGE
  add_mana(20);
endswitch;
@end example

@subsection Loop Statements

@strong{Syntax}:
@example
while condition
  body;
endwhile;

repeat
  body
until condition;

for local i = 0 to 99 by 1
  body;
endfor;
@end example

@strong{Examples}:

@example
while health > 0
  process_turn();
endwhile;

for local i = 1 to 10
  print(i);
endfor;
@end example

@strong{AST}: @code{(:perform :target loop-label)}

@subsection Method Definition

@strong{Syntax}:
@example
(method name &rest params
  body
)
@end example

@strong{Examples}:

@example
(method take_damage amount
  (= health (- health amount))
  (if (<= health 0) then
    (send self death))
)
@end example

@strong{AST}: @code{(:invoke :method "name" :using params)}

