;;;
;;;; LOG FAULT / DEBUG BREAK
;;;

(test stack/log-fault
  "LOG FAULT emits comment."
  (let ((asm (stack-asm '(:log-fault :code 1234))))
    (is (search "LOG FAULT" asm))))

(test stack/debug-break
  "DEBUG BREAK emits comment."
  (let ((asm (stack-asm '(:debug-break :code 42))))
