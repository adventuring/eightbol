;;;
;;;; STRING BLT
;;;

(test stack/string-blt
  "STRING dest FROM src emits block copy loop."
  (let ((slots (make-hash "Src" "Character" "Dst" "Character")))
    (let ((asm (stack-asm '(:string-blt :source "Src" :dest "Dst") :slots slots)))
      (is (search "push" asm)))))
